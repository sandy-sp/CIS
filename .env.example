# Host defaults for local runs. Docker Compose injects container service URLs automatically.
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
APP_TIMEZONE=America/New_York

APP_DEFAULT_LLM_BACKEND=ollama
APP_DEFAULT_EMBEDDING_BACKEND=ollama
APP_DEFAULT_OLLAMA_LLM_MODEL=qwen3:4b-instruct
APP_DEFAULT_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
